<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme using Material 3 parent -->
    <style name="Base.Theme.RideBooking" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Core colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/background</item>

        <!-- Backgrounds and surfaces -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorOnBackground">@color/on_background</item>
        <item name="colorOnSurface">@color/on_surface</item>

        <!-- Global Typography: Bundled Inter Font -->
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>

        <!-- Widgets default styling hints -->
        <item name="materialButtonStyle">@style/Widget.Material3.Button</item>
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
    </style>

    <style name="Theme.RideBooking" parent="Base.Theme.RideBooking" />
</resources>